    - isTransferringItems: bool
    - minecartOffset: float
  }
  class PassageController {
    - transitionSpeed: float
    - requiredInputThreshold: float
    - destinationSceneName: string
    - changeScene: ChangeScene
    - playerController: PlayerController
    - playerTransform: Transform
    - playerCollider: Collider
    - initialPlayerScale: Vector3
    - entryProgress: float
    - isPlayerInside: bool
  }
  class SurfaceInteractionSystem {
    - surfaceDetectionRange: float
    - surfaceReturnPoint: Transform
    - itemTransferSpeed: float
    - itemMoveSpeed: float
    - movementCurve: AnimationCurve
    - playerController: PlayerController
    - storageManager: StorageManager
    - isTransferringItems: bool
  }
}

package "Background" {
  class BackgroundController {
    + terrainDataManager: TerrainDataManager
    + playerTransform: Transform
    + backgroundTilePrefab: GameObject
    + viewDistance: Vector2Int
    + tileSize: Vector2
    - activeTiles: Map<Vector2Int, GameObject>
    - playerGridPos: Vector2Int
    - propertyBlock: MaterialPropertyBlock
  }
}

package "Terrain" {
  class BlockGenerator {
    - showBlockDebugInfo: bool
    - terrainManager: TerrainManager
    - random: System.Random
  }

  class "BlockGenerator.BlockGenerationData" as BlockGenerationData {
    + generationType: TerrainGenerationType
    + voxelsPerBlock: int
    + blockSize: float
    + blockPosition: Vector3Int
    + voxelWorldSize: float
  }

  class BlockManager {
    - blocks: List<BlockInstanceData>
    - showBlockDebugInfo: bool
    - terrainManager: TerrainManager
  }

  class "BlockManager.BlockInstanceData" as BlockInstanceData {
    + position: Vector3Int
    + worldPosition: Vector3
    + block: Block
    + isActive: bool
    + voxelCount: int
  }

  class Chunk {
    + chunkPosition: Vector3Int
  }

  class ChunkManager {
    - playerTransform: Transform
    - renderDistanceInChunks: int
    - chunkUpdateInterval: float
    - timeSinceLastChunkUpdate: float
    - currentPlayerChunk: Vector3Int
    - activeChunks: Dictionary<Vector3Int, Chunk>
    - _blockGenerationList: List<Vector3Int>
    - _processedBlocks: HashSet<Vector3Int>
    - terrainManager: TerrainManager
    - cancellationTokenSource: CancellationTokenSource
  }

  class TerrainManager {
    + terrainDataManager: TerrainDataManager
    - settings: TerrainSettings
    + playerTransform: Transform
    - chunkManager: ChunkManager
    - blockManager: BlockManager
    - blockGenerator: BlockGenerator
    - voxelManager: VoxelManager
    + showDebugInfo: bool
    - voxelCountText: Text
    + Settings: TerrainSettings
    + ChunkManager: ChunkManager
    + BlockManager: BlockManager
    + BlockGenerator: BlockGenerator
    + VoxelManager: VoxelManager
    + TerrainDataManager: TerrainDataManager
  }

  class TerrainSettings {
    + center: Vector3Int
    + seed: int
    + useRandomSeed: bool
    + initialChunkCount: Vector2Int
    + blocksPerChunk: Vector2Int
    + blockSize: float
    + voxelsPerBlock: int
    + generationType: TerrainGenerationType
    + blocksPerFrame: int
    + itemLoadDelay: float
  }

  enum TerrainGenerationType {
    SideScroller
    TopDown
    Custom
  }

  class Voxel {
    + blockPosition: Vector3Int
    + localPosition: Vector3Int
    + worldPosition: Vector3
    + isActive: bool
    + health: int
    + maxHealth: int
    + voxelType: VoxelType
    + lastModifiedTime: float
  }

  enum VoxelType {
    Standard
    Reinforced
    Fragile
    Unbreakable
    Special
  }

  class VoxelManager {
    - showVoxelDebugInfo: bool
    - trackedVoxels: Dictionary<Vector3Int, Dictionary<Vector3Int, Voxel>>
    - terrainManager: TerrainManager
  }

  package "Block" <<Rectangle>> {
    struct VoxelFaceTextureInfo {
      + faceNormal: Vector3
      + uvBase: Vector2
      + uvSize: Vector2
      + sourceTexture: Texture2D
      + isExposed: bool
    }

    class Block {
      - voxelManager: VoxelManager
      - blockPosition: Vector3Int
      + VoxelsPerBlock: int
      - maxHP: int
      + diggingThreshold: float
      - diggingFrameDelay: int
      - initialColor: Color
      - texture1: Texture2D
      - texture2: Texture2D
      - useTexture1Pattern: bool[,,]
      - voxelWorldSize: float
      - meshGenerator: BlockMeshGenerator
      - textureExtractor: VoxelTextureExtractor
      - itemDropper: BlockItemDropper
      - diggingSystem: BlockDiggingSystem
      - droppedItemPrefab: GameObject
      - disableRotation: bool
      - autoScale: bool
      - scaleMultiplier: float
      - enableTextureExtraction: bool
      - mesh: Mesh
      - meshFilter: MeshFilter
      - collider: MeshCollider
      - blockData: BlockData
      + BlockData: BlockData
    }

    class BlockMeshGenerator {
    }

    class VoxelTextureExtractor {
    }

    class BlockItemDropper {
    }

    class BlockDiggingSystem {
    }
  }

  package "Data" <<Rectangle>> {
    class BiomeData <<ScriptableObject>> {
      + biomeName: string
      + biomeType: BiomeType
      + maxHeight: int
      + minHeight: int
      + availableBlocks: List<BlockDistribution>
      + backgroundTexture: Texture2D
    }

    class BlockDistribution {
      + blockData: BlockData
      + distributionCurve: AnimationCurve
    }

    enum BiomeType {
      AltitudeBased
      Overwrite
    }
  }
}

  package "Data" <<Rectangle>> {
    class BiomeData <<ScriptableObject>> {
      + biomeName: string
      + biomeType: BiomeType
      + maxHeight: int
      + minHeight: int
      + availableBlocks: List<BlockDistribution>
      + backgroundTexture: Texture2D
    }

    class BlockDistribution {
      + blockData: BlockData
      + distributionCurve: AnimationCurve
    }

    enum BiomeType {
      AltitudeBased
      Overwrite
    }

    class BlockData <<ScriptableObject>> {
      + resourceType: ResourceType
      + voxelHp: int
      + materialType: MaterialType
      + textures: List<Texture2D>
      + droppedItemPrefab: GameObject
      + disableRotation: bool
      + autoScale: bool
      + scaleMultiplier: float
      + density: float
      + destroyedSound: AudioClip
      + destroyedSoundVolume: float
    }

    class BlockDataManager <<ScriptableObject>> {
      - blockDataMappings: List<BlockDataMapping>
      - _dataMap: Dictionary<ResourceType, BlockData>
    }

    class "BlockDataManager.BlockDataMapping" as BlockDataMapping {
      + resourceType: ResourceType
      + blockData: BlockData
    }

    enum MaterialType {
      Stone
      Soil
    }

    class TerrainDataManager <<ScriptableObject>> {
      + defaultBlockData: BlockData
      + defaultBackgroundTexture: Texture2D
      - biomeDataMappings: List<BiomeDataMapping>
      - _dataMap: Dictionary<BiomeType, BiomeData>
    }

    class "TerrainDataManager.BiomeDataMapping" as BiomeDataMapping {
      + biomeType: BiomeType
      + biomeData: BiomeData
    }
  }
}

package "Mining" {
  class Digger {
    + DiggingArea: BoxCollider
    - diggingArea: BoxCollider
    - pendingMiningModule: MiningModule
    - pendingMiningInfo: MiningInfo
    - isDiggingAreaOverridden: bool
  }

  class DroppedItem {
    + rb: Rigidbody
    + resourceType: ResourceType
    + scale: Vector3
    + blockDataName: string
    + uvBase: Vector2
    + uvSize: Vector2
    + useTexture1: bool
  }

  struct DroppedItemData {
    + position: Vector3
    + rotation: Quaternion
    + scale: Vector3
    + blockDataName: string
    + uvBase: Vector2
    + uvSize: Vector2
    + useTexture1: bool
    + isKinematic: bool
  }

  class DroppedItemManager <<Singleton>> {
    + WakeUpRadiusMultiplier: float
    + {static} Instance: DroppedItemManager
    + maxWakeUpsPerUpdate: int
    + MaxWakeUpPerStep: int
    + WakeUpStepDelay: float
    + MaxDownwardChain: int
    - _wakeUpRadiusMultiplier: float
    - itemPools: Map<GameObject, Queue<GameObject>>
    - instancePrefabMap: Map<GameObject, GameObject>
    - activeItems: List<DroppedItem>
    - itemStates: Map<DroppedItem, ItemState>
    - wakeUpRequestQueue: Queue<DroppedItem>
    - itemsInWakeUpQueue: HashSet<DroppedItem>
    - sleepCheckTimer: float
    - itemsByChunk: Map<Vector3Int, List<DroppedItemData>>
  }

  class MaterialSound {
    + materialType: MaterialType
    + sound: AudioClip
  }

  abstract class MiningTool <<ScriptableObject>> {
    # toolName: string
    # toolIcon: Sprite
    - toolTypeID: int
    - animationTriggerName: string
    - animationStateName: string
    - toolPrefab: GameObject
    + miningModule: MiningModule
    - volume: float
    - defaultMiningSound: AudioClip
    - materialSounds: List<MaterialSound>
    + ToolPrefab: GameObject
    + ToolTypeID: int
    + AnimationTriggerName: string
    + AnimationStateName: string
    + DefaultMiningSound: AudioClip
    + Volume: float
  }

  abstract class MiningToolBehaviour {
    + ToolData: MiningTool
    # user: GameObject
    # toolAnimator: Animator
    # digger: Digger
    + IsMining: bool
    + IsEquipped: bool
  }

  class Dynamite extends MiningTool {
  }

  class DynamiteMiningModule extends MiningModule {
    - dynamitePrefab: GameObject
    - throwForce: float
    - maxThrowDistance: float
    - gravity: float
    - explosionForce: float
    - diggingCenter: Vector3
    - diggingSize: Vector3
    + ProjectilePrefab: GameObject
    + ThrowForce: float
    + MaxThrowDistance: float
    + Gravity: float
    + ExplosionForce: float
    + DiggingCenter: Vector3
    + DiggingSize: Vector3
  }

  class DynamiteProjectile {
    - explosionDelay: float
    - enableDebugLogs: bool
    - behaviour: DynamiteToolBehaviour
    - hasExploded: bool
  }

  class DynamiteToolBehaviour extends MiningToolBehaviour {
    - owner: GameObject
    - playerController: PlayerController
  }

  class Pickaxe extends MiningTool {
  }

  class PickaxeMiningModule extends MiningModule {
    - centerOffset: Vector3
    - size: Vector3
    - miningForce: float
    - verticalCenterOffset: Vector3
    - verticalSize: Vector3
    - verticalMiningForce: float
    - mineTriggerName: string
    - isFacingRightBool: string
    - directionStateName: string
    + DiggingCenter: Vector3
    + DiggingSize: Vector3
    + MiningForce: float
    + VerticalDiggingCenter: Vector3
    + VerticalDiggingSize: Vector3
    + VerticalMiningForce: float
    + MineTriggerName: string
    + IsFacingRightBool: string
    + DirectionStateName: string
  }

  class PickaxeToolBehaviour extends MiningToolBehaviour {
    - toolMount: Transform
    - currentMoveMode: PlayerController.MoveMode
    - currentAimDirection: Vector3
    - useBuffered: bool
    - canBufferUse: bool
    - _playerController: PlayerController
  }
