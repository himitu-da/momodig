@startuml L2_Overview
' すべてのクラス名、プロパティとその関係をまとめたクラス図
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam classFontSize 15
skinparam classHeaderBackgroundColor #EEE
skinparam classBorderColor #333
skinparam classArrowColor #333
skinparam shadowing false

package "Interfaces" {
  interface IInventory {
    + maxCapacity: int
  }

  interface IItemManager {
    + WakeUpRadiusMultiplier: float
  }
}

package "Camera" {
  class CameraFollowController {
    - mainCamera: Camera
    - playerObject: GameObject
    - enableFollow: bool
    - followSpeed: float
    - useSmoothDamp: bool
    - sideScrollerOffset: Vector3
    - topDownOffset: Vector3
    - sideScrollerOrthographicSize: float
    - topDownOrthographicSize: float
    - playerController: PlayerController
    - velocity: Vector3
    - currentMode: PlayerController.MoveMode
    - lastMode: PlayerController.MoveMode
  }
}

package "Player" {
  class PlayerController {
    - moveSpeed: float
    - acceleration: float
    - deceleration: float
    - fallSpeedMultiplier: float
    - fallAcceleration: float
    - _currentMoveMode: MoveMode
    + currentMoveMode: MoveMode
    - scoreText: TextMeshProUGUI
    - depthText: TextMeshProUGUI
    - inventoryText: TextMeshProUGUI
    - inventoryCapacityText: TextMeshProUGUI
    - inventory: IInventory
    - itemManager: IItemManager
    + Inventory: IInventory
    + MousePosition: Vector2
    - itemPickupRetryInterval: float
    - score: int
    - rb: Rigidbody
    - controls: InputSystem_Actions
    - moveInput: Vector2
    + MoveInput: Vector2
    - mousePosition: Vector2
    - currentFallSpeed: float
    + lastMoveDirection: Vector3
    + IsFacingRight: bool
    - currentVelocity: Vector3
    - playerVisualsController: PlayerVisualsController
    + IsInPassage: bool
    - contactItems: List<GameObject>
    - pickupRetryCancellationTokenSource: CancellationTokenSource
    - minecartInteraction: MinecartPlayerInteractionSystem
    - miningToolsController: MiningToolsController
  }

  enum "PlayerController.MoveMode" as MoveMode {
    SideScroller
    TopDown
  }

  class MiningToolsController {
    - usableMiningTools: List<MiningTool>
    - _mainMiningTool: MiningTool
    - _subMiningTool: MiningTool
    - _mainDiggerPrefab: GameObject
    - _subDiggerPrefab: GameObject
    - toolMount: Transform
    - _behaviourCache: Map<MiningTool, MiningToolBehaviour>
    - _mainBehaviour: MiningToolBehaviour
    - _subBehaviour: MiningToolBehaviour
    - _mainDigger: Digger
    - _subDigger: Digger
    + mainMiningTool: MiningTool
    + subMiningTool: MiningTool
    - _playerController: PlayerController
    - _currentDirection: Vector3
  }

  class PlayerInventory {
    - _maxCapacity: int
    - resources: Map<ResourceType, int>
    + OnResourceAdded: Action<ResourceType, int>
    + OnResourceRemoved: Action<ResourceType, int>
    + OnTotalCountChanged: Action<int>
    + OnInventoryFullStateChanged: Action<bool>
    + maxCapacity: int
  }

  class PlayerVisualsController {
    - _animator: Animator
    - _playerController: PlayerController
    - _lastMoveDirection: Vector2
  }
}

package "OverWorld" {
  class OverWorldChangeScene {
    + changescene: ChangeScene
  }

  class ShopStateManager <<Singleton>> {
    + {static} Instance: ShopStateManager
    + startMode: ShopMode
  }

  enum "ShopStateManager.ShopMode" as ShopMode {
    Garage
    Workshop
  }
}

package "Interaction" {
  class MinecartPlayerInteractionSystem {
    - minecartDetectionRange: float
    - itemTransferSpeed: float
    - itemMoveSpeed: float
    - movementCurve: AnimationCurve
    - minecartManager: MinecartManager
