class ChangeScene

' ##################################
' #####  依存関係の定義 #####
' ##################################

' --- 実装関係 ---
PlayerInventory <|.. IInventory
DroppedItemManager <|.. IItemManager

' --- Playerパッケージ ---
PlayerController o-- "1" PlayerVisualsController
PlayerController o-- "1" MiningToolsController
PlayerController ..> IInventory : uses
PlayerController ..> IItemManager : uses
MiningToolsController --> PlayerController
PlayerVisualsController --> PlayerController

' --- Miningパッケージ ---
MiningToolsController o-- "2" Digger : creates
MiningToolsController o-- "*" MiningTool : aggregates
MiningToolsController ..> MiningToolBehaviour : creates
Digger ..> "Terrain.Block.Block" : uses
Digger ..> DroppedItemManager : uses
Digger ..> "Tools.MiningModule" : uses
"Tools.MiningTool" o-- "1" "Tools.MiningModule" : aggregates
"Tools.MiningTool" ..> "Tools.MiningToolBehaviour" : creates
"Tools.MiningToolBehaviour" --> "Tools.MiningTool"
"Tools.MiningToolBehaviour" --> Digger
"Tools.MiningToolBehaviour" ..> PlayerController : uses
"Tools.MiningToolBehaviour" ..> "Common.AudioManager" : uses
DroppedItemManager ..> "Common.GameDataPersistenceManager" : uses
DroppedItemManager ..> "Terrain.TerrainManager" : uses

' --- Terrainパッケージ ---
TerrainManager o-- "1" ChunkManager
TerrainManager o-- "1" BlockManager
TerrainManager o-- "1" BlockGenerator
TerrainManager o-- "1" VoxelManager
TerrainManager ..> "Common.GameDataPersistenceManager" : uses
VoxelManager --> TerrainManager
VoxelManager ..> BlockManager : uses
VoxelManager ..> "Common.GameDataPersistenceManager" : uses
VoxelManager ..> "Data.BlockData" : uses
"Block.Block" --> VoxelManager
"Block.Block" --> "Data.BlockData"
"Block.Block" *-- "Block.BlockDiggingSystem"
"Block.Block" *-- "Block.BlockItemDropper"
"Block.Block" *-- "Block.BlockMeshGenerator"
"Block.Block" *-- "Block.VoxelTextureExtractor"
"Block.BlockDiggingSystem" ..> VoxelManager : modifies
"Block.BlockDiggingSystem" ..> "Block.BlockItemDropper" : uses
"Block.BlockItemDropper" ..> DroppedItem : creates
"Block.BlockMeshGenerator" ..> VoxelManager : queries

' --- Interactionパッケージ ---
PlayerController ..> MinecartPlayerInteractionSystem : uses
MinecartPlayerInteractionSystem --> PlayerController
MinecartPlayerInteractionSystem --> "Minecart.MinecartManager"
PassageController --> PlayerController
PassageController --> "SceneManagement.ChangeScene"
SurfaceInteractionSystem --> PlayerController
SurfaceInteractionSystem --> "Storage.StorageManager"

' --- Minecartパッケージ ---
MinecartManager o-- "*" Minecart : creates
MinecartManager ..> "Storage.StorageManager" : uses
Minecart o-- "1" MinecartMovement

' --- Storageパッケージ ---
StorageManager ..> "Common.GameDataPersistenceManager" : uses

' --- ShopSceneパッケージ ---
BuyManager ..> "Storage.StorageManager" : uses
BuyManager ..> "Popup.MaterialCheck"
BuyManager ..> "Popup.PopBuyManager"
BuyManager ..> ItemData
ContentManager ..> BuyManager
ContentManager ..> ItemUI : creates
ItemUI ..> BuyManager
ItemUI ..> ItemData

' --- その他パッケージ ---
CameraFollowController ..> PlayerController
BackgroundController ..> "Data.TerrainDataManager"

@enduml
