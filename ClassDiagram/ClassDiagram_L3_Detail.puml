    - terrainManager: TerrainManager
    + {method} Initialize(TerrainManager)
    + {method} CreateBlock(Vector3Int, Vector3, bool[,,], BlockData, float, int, Transform): BlockInstanceData
    - {method} CreateBlockMaterial(GameObject, BlockData)
    - {method} CalculateVoxelCount(bool[,,]): int
    + {method} GetBlockAt(Vector3Int): BlockInstanceData
    + {method} GetAllBlocks(): List<BlockInstanceData>
