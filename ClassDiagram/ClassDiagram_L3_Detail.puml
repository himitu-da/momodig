  }

  class MinecartMovement {
    + targetPosition: Vector3
    + moveSpeed: float
    - Start()
    - Update()
  }

  MinecartManager o-- "*" Minecart
  Minecart +-- MinecartState
  Minecart o-- MinecartMovement
}


package "Terrain" {
  class BlockGenerator {
    - showBlockDebugInfo: bool
    - terrainManager: TerrainManager
    - random: System.Random
    + {method} Initialize(TerrainManager, int)
    + {method} ResetRandom(int)
    + {method} GenerateBlockPattern(BlockGenerationData): bool[,,]
    - {method} GenerateSideScrollerPattern(BlockGenerationData, bool[,,]): bool[,,]
    - {method} GenerateTopDownPattern(BlockGenerationData, bool[,,]): bool[,,]
    - {method} GenerateCustomPattern(BlockGenerationData, bool[,,]): bool[,,]
    + {method} CountActiveVoxels(bool[,,]): int
    + {method} CalculatePatternDensity(bool[,,]): float
    + {method} VisualizePattern(bool[,,], int): string
    + {method} ClonePattern(bool[,,]): bool[,,]
    + {method} GetDebugInfo(): string
    + {method} GetBlockDataForPosition(Vector3Int): BlockData
  }

  class "BlockGenerator.BlockGenerationData" as BlockGenerationData {
    + generationType: TerrainGenerationType
    + voxelsPerBlock: int
    + blockSize: float
    + blockPosition: Vector3Int
    + voxelWorldSize: float
    + {method} BlockGenerationData(TerrainGenerationType, int, float, Vector3Int)
