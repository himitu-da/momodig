    - {method} OnDestroy()
    - {method} Update()
    + {method} GenerateTerrain()
    - {method} UpdateChunks()
    - {method} ProcessBlockGenerationQueue(CancellationToken): UniTask
    - {method} GenerateSingleBlock(Vector3Int)
    - {method} GetOrCreateChunk(Vector3Int): Chunk
    + {method} ClearChunks()
    - {method} GetChunkPositionFromWorld(Vector3): Vector3Int
    - {method} GetChunkCenterWorldPosition(Vector3Int): Vector3
    - {method} GetBlockWorldPosition(Vector3Int): Vector3
    - {method} LoadItemsWithDelay(Vector3Int): UniTask
  }

  class TerrainManager {
    + terrainDataManager: TerrainDataManager
    - settings: TerrainSettings
    + playerTransform: Transform
    - chunkManager: ChunkManager
    - blockManager: BlockManager
    - blockGenerator: BlockGenerator
    - voxelManager: VoxelManager
    + showDebugInfo: bool
    - voxelCountText: Text
    + Settings: TerrainSettings
    + ChunkManager: ChunkManager
    + BlockManager: BlockManager
    + BlockGenerator: BlockGenerator
    + VoxelManager: VoxelManager
    + TerrainDataManager: TerrainDataManager
