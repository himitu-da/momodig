    + {method} ClearAllVoxels()
    + {method} GetDebugInfo(): string
    - {method} OnDestroy()
  }

  package "Data" <<Rectangle>> {
    class BiomeData <<ScriptableObject>> {
      + biomeName: string
      + biomeType: BiomeType
      + maxHeight: int
      + minHeight: int
      + availableBlocks: List<BlockDistribution>
      + backgroundTexture: Texture2D
    }

    class BlockDistribution {
      + blockData: BlockData
      + distributionCurve: AnimationCurve
    }

    enum BiomeType {
      AltitudeBased
      Overwrite
    }
  }

  package "Block" <<Rectangle>> {
    struct VoxelFaceTextureInfo {
      + faceNormal: Vector3
      + uvBase: Vector2
      + uvSize: Vector2
      + sourceTexture: Texture2D
      + isExposed: bool
      + {method} VoxelFaceTextureInfo(Vector3, Vector2, Vector2, Texture2D, bool)
    }

    class Block {
      - voxelManager: VoxelManager
