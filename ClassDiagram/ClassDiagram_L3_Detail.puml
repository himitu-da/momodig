@startuml
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam classFontSize 15
skinparam classHeaderBackgroundColor #EEE
skinparam classBorderColor #333
skinparam classArrowColor #333
skinparam shadowing false

package "Interfaces" {
  interface IInventory {
    + maxCapacity: int
    + CanAddResource(type: ResourceType, amount: int = 1): bool
    + AddResource(type: ResourceType, amount: int = 1): bool
    + GetTotalItemCount(): int
    + GetResourceCount(type: ResourceType): int
    + RemoveResource(type: ResourceType, amount: int = 1): int
    + IsEmpty(): bool
    + GetAllResources(): Map<ResourceType, int>
    + OnResourceAdded(type: ResourceType, amount: int)
    + OnTotalCountChanged(count: int)
  }

  interface IItemManager {
    + WakeUpRadiusMultiplier: float
    + ReturnItem(itemObject: GameObject): void
    + WakeUpItemsNearPosition(position: Vector3, radius: float): void
  }
}

package "Data" {
  enum ResourceType {
    Stone
    Iron
    Gold
    Diamond
  }

  class ResourceTypeUtility <<static>> {
    + {static} GetResourceColor(resourceType: ResourceType): Color
    + {static} GetDisplayName(resourceType: ResourceType): string
    + {static} GetBaseValue(resourceType: ResourceType): int
  }

  class BlockData <<ScriptableObject>> {
    + voxelHp: int
    + textures: List<Texture2D>
    + droppedItemPrefab: GameObject
    + disableRotation: bool
    + autoScale: bool
    + scaleMultiplier: float
  }

  class "BlockDataManager.BlockDataMapping" as BlockDataMapping {
    + resourceType: ResourceType
    + blockData: BlockData
  }

  class BlockDataManager <<ScriptableObject>> {
    - blockDataMappings: List<BlockDataMapping>
    - _dataMap: Map<ResourceType, BlockData>
    + Initialize()
    + GetBlockData(resourceType: ResourceType): BlockData
  }

  BlockDataManager +-- BlockDataMapping
  BlockDataManager ..> BlockData
}

package "Player" {
  class PlayerController {
    + moveSpeed: float
    + acceleration: float
    + deceleration: float
    + fallSpeedMultiplier: float
    + fallAcceleration: float
    + currentMoveMode: MoveMode
    + scoreText: Text
    + depthText: Text
    + inventoryText: Text
    + itemPickupRetryInterval: float
    + Inventory: IInventory
    + MousePosition: Vector2
    + lastMoveDirection: Vector3
    + IsFacingRight: bool
    - inventory: IInventory
    - itemManager: IItemManager
    - score: int
    - rb: Rigidbody
    - controls: InputSystem_Actions
    - moveInput: Vector2
    - mousePosition: Vector2
    - minecartInteraction: MinecartInteractionSystem
    - miningToolsController: MiningToolsController
    + GetMouseWorldPosition(distance: float): Vector3
  }

  enum "PlayerController.MoveMode" as MoveMode {
    SideScroller
    TopDown
  }

  class PlayerInventory {
    + maxCapacity: int
    - resources: Map<ResourceType, int>
    + OnResourceAdded(type: ResourceType, amount: int)
    + OnResourceRemoved(type: ResourceType, amount: int)
    + OnTotalCountChanged(count: int)
    + OnInventoryFullStateChanged(isFull: bool)
    + PlayerInventory()
    + CanAddResource(type: ResourceType, amount: int): bool
    + AddResource(type: ResourceType, amount: int): bool
    + RemoveResource(type: ResourceType, amount: int): int
    + GetTotalItemCount(): int
    + GetResourceCount(type: ResourceType): int
    + GetAllResources(): Map<ResourceType, int>
    + IsEmpty(): bool
    + IsFull(): bool
    + Clear()
  }

  class MiningToolsController {
    - usableMiningTools: List<MiningTool>
    - _mainMiningTool: MiningTool
    - _subMiningTool: MiningTool
    - _mainDiggerPrefab: GameObject
    - _subDiggerPrefab: GameObject
    - toolMount: Transform
    - _behaviourCache: Map<MiningTool, MiningToolBehaviour>
    - _mainBehaviour: MiningToolBehaviour
    - _subBehaviour: MiningToolBehaviour
    - _mainDigger: Digger
    - _subDigger: Digger
    + mainMiningTool: MiningTool
    + subMiningTool: MiningTool
    + UseMainMineTool(user: GameObject)
    + UseSubMineTool(user: GameObject)
    + UpdateRotation(direction: Vector3, moveMode: PlayerController.MoveMode)
    + SetMainTool(tool: MiningTool)
    + SetSubTool(tool: MiningTool, active: bool)
    + EquipMain(tool: MiningTool, user: GameObject)
    + EquipSub(tool: MiningTool, user: GameObject, active: bool)
  }

  PlayerController +-- MoveMode
  PlayerController o-- MiningToolsController
  PlayerController ..> IInventory : inventory
  PlayerController ..> IItemManager : itemManager
  PlayerController ..> MinecartInteractionSystem
}

package "Mining" {
  class Digger {
    + DiggingArea: BoxCollider
    - pendingMiningModule: MiningModule
    - pendingMiningInfo: MiningInfo
    + SetPendingMining(module: MiningModule, info: MiningInfo)
    + ExecuteDigFromAnimation()
    + SetDiggingArea(area: BoxCollider)
    + UpdateDiggingAreaTransform(position: Vector3, rotation: Quaternion)
    + SetDiggingAreaParameters(center: Vector3, size: Vector3)
    + Dig(damagePerHit: int, info: MiningInfo)
  }

  enum MiningType {
    Directional
    ArcSwing
    Explosive
  }

  struct MiningInfo {
    + Type: MiningType
    + SourcePoint: Vector3
    + Direction: Vector3
    + Force: float
    + IsFacingRight: bool
    + {static} Directional(sourcePoint: Vector3, direction: Vector3, force: float): MiningInfo
    + {static} Explosive(sourcePoint: Vector3, force: float): MiningInfo
    + {static} ArcSwing(sourcePoint: Vector3, isFacingRight: bool, force: float): MiningInfo
  }

  class DroppedItem {
    + rb: Rigidbody
    + resourceType: ResourceType
  }

  class "DroppedItemManager.ItemState" as ItemState {
    + isSleeping: bool
  }

  class DroppedItemManager <<Singleton>> {
    + {static} Instance: DroppedItemManager
    + WakeUpRadiusMultiplier: float
    + maxWakeUpsPerUpdate: int
    + MaxWakeUpPerStep: int
    + WakeUpStepDelay: float
    + MaxDownwardChain: int
    + WakeUpItemsInRadius(center: Vector3, size: Vector3, rotation: Quaternion)
    + ApplyForceToItemsInRadius(center: Vector3, size: Vector3, rotation: Quaternion, info: MiningInfo)
    + WakeUpItemsNearPosition(position: Vector3, radius: float)
    + GetItem(prefab: GameObject): GameObject
    + ReturnItem(itemInstance: GameObject)
  }

  DroppedItemManager +-- ItemState
  DroppedItemManager o-- "*" DroppedItem
  MiningInfo +-- MiningType

  package "Tools" {
    abstract class MiningTool <<ScriptableObject>> {
      # toolName: string
      # toolIcon: Sprite
      - toolPrefab: GameObject
      + miningModule: MiningModule
      + ToolPrefab: GameObject
      + InstantiateBehaviour(parent: Transform): MiningToolBehaviour
    }

    abstract class MiningModule <<ScriptableObject>> {
      # damagePerHit: int
      + {abstract} DiggingCenter: Vector3
      + {abstract} DiggingSize: Vector3
      + DamagePerHit: int
      + {abstract} Execute(user: GameObject)
    }

    abstract class MiningToolBehaviour {
      + ToolData: MiningTool
      # user: GameObject
      # digger: Digger
      + IsEquipped: bool
      + BindTool(tool: MiningTool)
      + OnEquip(user: GameObject)
      + OnUnequip()
      + SetDigger(digger: Digger)
      + {abstract} Use()
      + UpdateAim(direction: Vector3, moveMode: PlayerController.MoveMode)
    }

    class Dynamite extends MiningTool {
    }

    class DynamiteMiningModule extends MiningModule {
      - dynamitePrefab: GameObject
      - throwForce: float
      - maxThrowDistance: float
      - gravity: float
      - explosionForce: float
      + ProjectilePrefab: GameObject
    }

    class DynamiteProjectile {
      - explosionDelay: float
      - behaviour: DynamiteToolBehaviour
      + SetBehaviour(b: DynamiteToolBehaviour)
      - Explode()
    }

    class DynamiteToolBehaviour extends MiningToolBehaviour {
      - owner: GameObject
      - playerController: PlayerController
      + Use()
      + PerformExplosionMining(explosionPosition: Vector3, center: Vector3, size: Vector3, damage: int, force: float)
    }

    class Pickaxe extends MiningTool {
    }

    class PickaxeMiningModule extends MiningModule {
      - miningForce: float
      - mineTriggerName: string
      - isFacingRightBool: string
      + MiningForce: float
    }

    class PickaxeToolBehaviour extends MiningToolBehaviour {
      - playerAnimator: Animator
      - currentAimDirection: Vector3
      + Use()
      + ExecuteDigFromAnimation()
    }

    MiningTool o-- MiningModule
    MiningTool ..> MiningToolBehaviour : creates
    MiningToolBehaviour ..> MiningTool
    MiningToolBehaviour ..> Digger
    DynamiteToolBehaviour ..> DynamiteProjectile : creates
    DynamiteToolBehaviour ..> PlayerController
    DynamiteProjectile ..> DynamiteToolBehaviour
    PickaxeToolBehaviour ..> Digger
  }
}

package "Minecart" {
  enum MinecartState {
    Following
    GoingToGround
    Unloading
  }

  class Minecart {
    + gameObject: GameObject
    + movement: MinecartMovement
    + resources: Map<ResourceType, int>
    + time: float
    + state: MinecartState
    + CurrentLoad: int
    + Minecart(obj: GameObject)
    + ClearResources()
  }

  class MinecartManager {
    + playerTransform: Transform
    + minecartPrefab: GameObject
    + CartCapacity: int
    + groundStationPosition: Vector3
    + followMoveSpeed: float
    + groundMoveSpeed: float
    + unloadTime: float
    + cartunit: int
    + minecarts: List<Minecart>
    + pathRecordInterval: float
    + cartDistanceInPoints: int
    + maxPathPoints: int
    + digable: bool
    + addnewcart()
    + updatevalue(minecartnum: int, type: ResourceType, value: int)
    + UpdateMinecartPositions()
  }

  class MinecartMovement {
    + targetPosition: Vector3
    + moveSpeed: float
  }

  class MinecartInteractionSystem {
    - minecartDetectionRange: float
    - itemTransferSpeed: float
    - itemMoveSpeed: float
    - movementCurve: AnimationCurve
    - minecartManager: MinecartManager
    - isTransferringItems: bool
    - playerController: PlayerController
    + CheckMinecartProximity()
    + GetDetectionRange(): float
    + SetDetectionRange(range: float)
    + IsTransferringItems(): bool
    + GetDebugInfo(): string
  }

  MinecartManager o-- "*" Minecart
  Minecart +-- MinecartState
  Minecart o-- MinecartMovement
  MinecartInteractionSystem ..> MinecartManager
}


package "Terrain" {
  package "Block" {
    class Block {
      + VoxelsPerBlock: int
      + diggingThreshold: float
      - voxelManager: VoxelManager
      - blockPosition: Vector3Int
      - diggingSystem: BlockDiggingSystem
      - blockData: BlockData
      + Initialize(manager: VoxelManager, position: Vector3Int, pattern: bool[,,], voxelsPerBlock: int, worldBlockSize: float, data: BlockData)
      + TakeDamage(localPos: Vector3, damage: int)
      + DigVoxels(diggingArea: BoxCollider, damagePerHit: int): IEnumerator
      + GenerateMesh()
    }

    class BlockMeshGenerator {
      + GenerateMesh(block: Block, voxelManager: VoxelManager, blockPosition: Vector3Int, voxelsPerBlock: int, maxHP: int, initialColor: Color, mesh: Mesh, collider: MeshCollider)
    }

    class VoxelTextureExtractor {
      + VoxelTextureExtractor(enableExtraction: bool, resolution: int)
      + ApplyVoxelTextureToDroppedItem(item: GameObject, ...)
      + ExtractVoxelTextureRegion(faceInfo: VoxelFaceTextureInfo): Texture2D
    }

    class BlockItemDropper {
      + Initialize(data: BlockData, ...)
      + DropItem(position: Vector3, voxelX: int, voxelY: int, voxelZ: int)
    }

    class BlockDiggingSystem {
      + Initialize(manager: VoxelManager, ...)
      + TakeDamage(localPos: Vector3, damage: int)
      + DigVoxels(diggingArea: BoxCollider, damagePerHit: int): IEnumerator
    }

    struct VoxelFaceTextureInfo {
      + faceNormal: Vector3
      + uvBase: Vector2
      + uvSize: Vector2
      + sourceTexture: Texture2D
      + isExposed: bool
    }
  }

  class "BlockGenerator.BlockGenerationData" as BlockGenerationData {
    + generationType: TerrainGenerationType
    + voxelsPerBlock: int
    + blockSize: float
    + blockPosition: Vector3Int
    + voxelWorldSize: float
  }

  class BlockGenerator {
    - terrainManager: TerrainManager
    + Initialize(manager: TerrainManager)
    + GenerateBlockPattern(data: BlockGenerationData): bool[,,]
  }

  class "BlockManager.BlockInstanceData" as BlockInstanceData {
    + position: Vector3Int
    + worldPosition: Vector3
    + block: Terrain.Block.Block
    + isActive: bool
    + voxelCount: int
  }

  class BlockManager {
    - terrainManager: TerrainManager
    + Initialize(manager: TerrainManager)
    + CreateBlock(blockPos: Vector3Int, worldPos: Vector3, pattern: bool[,,], data: BlockData, blockSize: float, voxelsPerBlock: int, parent: Transform): BlockInstanceData
    + GetBlockAt(position: Vector3Int): BlockInstanceData
    + ClearAllBlocks()
  }

  class Chunk {
    + chunkPosition: Vector3Int
    + Initialize(position: Vector3Int)
  }
  
  class ChunkManager {
    - playerTransform: Transform
    - renderDistanceInChunks: int
    - terrainManager: TerrainManager
    + Initialize(manager: TerrainManager)
    + GenerateTerrain()
    + ClearChunks()
  }

  enum TerrainGenerationType {
    SideScroller
    TopDown
    Custom
  }

  class TerrainSettings {
    + center: Vector3Int
    + initialChunkCount: Vector2Int
    + blocksPerChunk: Vector2Int
    + blockSize: float
    + voxelsPerBlock: int
    + generationType: TerrainGenerationType
    + blocksPerFrame: int
  }

  class TerrainManager {
    + blockData: BlockData
    + settings: TerrainSettings
    + playerTransform: Transform
    + chunkManager: ChunkManager
    + blockManager: BlockManager
    + blockGenerator: BlockGenerator
    + voxelManager: VoxelManager
    + Settings: TerrainSettings
    + ChunkManager: ChunkManager
    + BlockManager: BlockManager
    + BlockGenerator: BlockGenerator
    + VoxelManager: VoxelManager
    + ClearTerrain()
    + RegenerateTerrain()
  }

  enum VoxelType {
    Standard
    Reinforced
    Fragile
    Unbreakable
    Special
  }

  class Voxel {
    + blockPosition: Vector3Int
    + localPosition: Vector3Int
    + worldPosition: Vector3
    + isActive: bool
    + health: int
    + maxHealth: int
    + voxelType: VoxelType
    + Voxel(blockPos: Vector3Int, localPos: Vector3Int, worldPos: Vector3, hp: int, type: VoxelType)
  }

  class VoxelManager {
    - terrainManager: TerrainManager
    + Initialize(manager: TerrainManager)
    + RegisterVoxelsFromPattern(pattern: bool[,,], blockPos: Vector3Int, blockWorldPos: Vector3, data: BlockData, blockSize: float, voxelsPerBlock: int)
    + GetVoxelAt(blockPos: Vector3Int, localPos: Vector3Int): Voxel
    + DamageVoxel(blockPos: Vector3Int, localPos: Vector3Int, damage: int): bool
    + DestroyVoxel(blockPos: Vector3Int, localPos: Vector3Int): bool
    + GetVoxelsInBlock(blockPos: Vector3Int): List<Voxel>
    + ClearAllVoxels()
  }

  TerrainManager o-- TerrainSettings
  TerrainManager o-- ChunkManager
  TerrainManager o-- BlockManager
  TerrainManager o-- BlockGenerator
  TerrainManager o-- VoxelManager
  TerrainManager ..> BlockData
  ChunkManager o-- "*" Chunk
  ChunkManager ..> TerrainManager
  BlockManager +-- BlockInstanceData
  BlockManager ..> TerrainManager
  BlockInstanceData o-- Terrain.Block.Block
  BlockGenerator +-- BlockGenerationData
  BlockGenerator ..> TerrainManager
  VoxelManager o-- "*" Voxel
  VoxelManager ..> TerrainManager
  Voxel +-- VoxelType
  Terrain.Block.Block ..> VoxelManager
  Terrain.Block.Block ..> BlockData
}


' Relationships between packages
MinecartInteractionSystem ..> PlayerController
Terrain.Block.Block ..> PlayerController
Terrain.Block.Block ..> DroppedItemManager
MiningToolsController o-- "2" Mining.Digger
MiningToolsController o-- "*" Mining.Tools.MiningTool
MiningToolsController ..> Mining.Tools.MiningToolBehaviour

' Block System Relationships (updated)
Terrain.Block.Block *-- Terrain.Block.BlockMeshGenerator : contains
Terrain.Block.Block *-- Terrain.Block.VoxelTextureExtractor : contains
Terrain.Block.Block *-- Terrain.Block.BlockItemDropper : contains
Terrain.Block.Block *-- Terrain.Block.BlockDiggingSystem : contains
Terrain.Block.BlockItemDropper ..> Terrain.Block.VoxelTextureExtractor : uses
Terrain.Block.BlockDiggingSystem ..> Terrain.Block.BlockItemDropper : uses
Terrain.Block.BlockDiggingSystem ..> Terrain.Block.Block : references
Terrain.Block.VoxelTextureExtractor ..> Terrain.Block.VoxelFaceTextureInfo : creates
Terrain.Block.BlockItemDropper ..> DroppedItem : creates
Terrain.Block.BlockMeshGenerator ..> VoxelManager : queries
Terrain.Block.BlockDiggingSystem ..> VoxelManager : modifies

package "Camera" {
  class CameraFollowController {
    - mainCamera: Camera
    - playerObject: GameObject
    + enableFollow: bool
    + followSpeed: float
    + useSmoothDamp: bool
    + sideScrollerOffset: Vector3
    + topDownOffset: Vector3
    + sideScrollerOrthographicSize: float
    + topDownOrthographicSize: float
    - playerController: PlayerController
    + SetFollowEnabled(enabled: bool)
    + SetFollowSpeed(speed: float)
    + SetOffset(mode: PlayerController.MoveMode, offset: Vector3)
    - UpdateCameraPosition()
    - UpdateCameraSettings()
  }
}

CameraFollowController ..> PlayerController

package "Storage" {
  class StorageManager <<Singleton>> {
    + {static} Instance: StorageManager
    - storedResources: Map<ResourceType, int>
    + AddResources(resourcesToAdd: Map<ResourceType, int>)
    + GetResourceAmount(type: ResourceType): int
    + GetAllStoredResources(): Map<ResourceType, int>
  }
}

MinecartManager ..> StorageManager

' Implementations
IInventory <|.. PlayerInventory
IItemManager <|.. DroppedItemManager

package "SceneManagement" {
  class ChangeScene {
    + OnClickToChangeScene(sceneNameToChange: string)
  }
}

@enduml
