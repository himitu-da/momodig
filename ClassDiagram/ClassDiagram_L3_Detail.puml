@startuml L3_Detail
' すべてのクラス名とメソッドとその関係をまとめたクラス図
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam classFontSize 15
skinparam classHeaderBackgroundColor #EEE
skinparam classBorderColor #333
skinparam classArrowColor #333
skinparam shadowing false

package "Interfaces" {
  interface IInventory {
    + maxCapacity: int
    + CanAddResource(type: ResourceType, amount: int = 1): bool
    + AddResource(type: ResourceType, amount: int = 1): bool
    + GetTotalItemCount(): int
    + GetResourceCount(type: ResourceType): int
    + RemoveResource(type: ResourceType, amount: int = 1): int
    + IsEmpty(): bool
    + GetAllResources(): Map<ResourceType, int>
    + OnResourceAdded(type: ResourceType, amount: int)
    + OnTotalCountChanged(count: int)
  }

  interface IItemManager {
    + WakeUpRadiusMultiplier: float
    + ReturnItem(itemObject: GameObject): void
    + WakeUpItemsNearPosition(position: Vector3, radius: float): void
  }
}

package "Data" {
  class BlockData <<ScriptableObject>> {
    + voxelHp: int
    + textures: List<Texture2D>
    + droppedItemPrefab: GameObject
    + disableRotation: bool
    + autoScale: bool
    + scaleMultiplier: float
  }

  class "BlockDataManager.BlockDataMapping" as BlockDataMapping {
    + resourceType: ResourceType
    + blockData: BlockData
  }

  class BlockDataManager <<ScriptableObject>> {
    - blockDataMappings: List<BlockDataMapping>
    - _dataMap: Map<ResourceType, BlockData>
    + Initialize()
    + GetBlockData(resourceType: ResourceType): BlockData
  }

  BlockDataManager +-- BlockDataMapping
  BlockDataManager ..> BlockData
}

package "Player" {
  class PlayerController {
    - moveSpeed: float
    - acceleration: float
    - deceleration: float
    - fallSpeedMultiplier: float
    - fallAcceleration: float
    - _currentMoveMode: MoveMode
    + currentMoveMode: MoveMode
    - scoreText: TextMeshProUGUI
    - depthText: TextMeshProUGUI
    - inventoryText: TextMeshProUGUI
    - inventoryCapacityText: TextMeshProUGUI
    - inventory: IInventory
    - itemManager: IItemManager
    + Inventory: IInventory
    + MousePosition: Vector2
    - itemPickupRetryInterval: float
    - score: int
    - rb: Rigidbody
    - controls: InputSystem_Actions
    - moveInput: Vector2
    + MoveInput: Vector2
    - mousePosition: Vector2
    - currentFallSpeed: float
    + lastMoveDirection: Vector3
    + IsFacingRight: bool
    - currentVelocity: Vector3
    - playerVisualsController: PlayerVisualsController
    + IsInPassage: bool
    - contactItems: List<GameObject>
    - pickupRetryCancellationTokenSource: CancellationTokenSource
    - minecartInteraction: MinecartPlayerInteractionSystem
    - miningToolsController: MiningToolsController
    + ScreenToWorldPoint(screenPosition: Vector2, distance: float): Vector3
    + GetMouseWorldPosition(distance: float): Vector3
    - Awake()
    - OnValidate()
    - OnEnable()
    - OnDisable()
    - OnDestroy()
    - Update()
    - FixedUpdate()
    - OnMainMine(context: InputAction.CallbackContext)
    - OnSubMine(context: InputAction.CallbackContext)
    - IsPointerOverNonMineableUI(): bool
    - OnCollisionEnter(collision: Collision)
    - OnCollisionExit(collision: Collision)
    - PickupRetryAsync(cancellationToken: CancellationToken): UniTask
    - TryPickupItem(itemObject: GameObject)
    - UpdateScoreText()
    - UpdateDepthText()
    - UpdateInventoryUI()
    - UpdateInventoryCapacityUI()
    - UpdateConstraints()
    - OnInventoryTotalCountChanged(newTotal: int)
    + SetToolAnimationType(toolId: int)
    + TriggerMineAnimation(direction: Vector3)
  }

  enum "PlayerController.MoveMode" as MoveMode {
    SideScroller
    TopDown
  }

  class PlayerInventory {
    - _maxCapacity: int
    - resources: Map<ResourceType, int>
    + OnResourceAdded: Action<ResourceType, int>
    + OnResourceRemoved: Action<ResourceType, int>
    + OnTotalCountChanged: Action<int>
    + OnInventoryFullStateChanged: Action<bool>
    + maxCapacity: int
    + PlayerInventory()
    + CanAddResource(type: ResourceType, amount: int): bool
    + AddResource(type: ResourceType, amount: int): bool
    + RemoveResource(type: ResourceType, amount: int): int
    + GetTotalItemCount(): int
    + GetResourceCount(type: ResourceType): int
    + GetAllResources(): Map<ResourceType, int>
    + IsEmpty(): bool
    + IsFull(): bool
    + Clear()
    + ToString(): string
  }

  class MiningToolsController {
    - usableMiningTools: List<MiningTool>
    - _mainMiningTool: MiningTool
    - _subMiningTool: MiningTool
    - _mainDiggerPrefab: GameObject
    - _subDiggerPrefab: GameObject
    - toolMount: Transform
    - _behaviourCache: Map<MiningTool, MiningToolBehaviour>
    - _mainBehaviour: MiningToolBehaviour
    - _subBehaviour: MiningToolBehaviour
    - _mainDigger: Digger
    - _subDigger: Digger
    + mainMiningTool: MiningTool
    + subMiningTool: MiningTool
    - _playerController: PlayerController
    - _currentDirection: Vector3
    - Awake()
    + UseMainMineTool(user: GameObject, direction: Vector3)
    + UseSubMineTool(user: GameObject, direction: Vector3)
    + UpdateRotation(direction: Vector3, moveMode: PlayerController.MoveMode)
    - UpdateToolRotation(direction: Vector3, moveMode: PlayerController.MoveMode)
    + GetCurrentToolTriggerName(): string
    + GetCurrentToolStateName(): string
    + SetMainTool(tool: MiningTool)
    + SetSubTool(tool: MiningTool, active: bool)
    - GetOrCreateBehaviour(tool: MiningTool): MiningToolBehaviour
    + EquipMain(tool: MiningTool, user: GameObject)
    + EquipSub(tool: MiningTool, user: GameObject, active: bool)
  }

  class PlayerVisualsController {
    - _animator: Animator
    - _playerController: PlayerController
    - _lastMoveDirection: Vector2
    - Awake()
    + SetToolAnimationType(toolId: int)
    + TriggerMineAnimation(toolStateName: string, direction: Vector3)
    + OnMineAnimationEnd()
    - GetAnimationDirection(direction: Vector3): Vector2
    + UpdateMovementAnimation(moveDirection: Vector3)
  }

  PlayerController +-- MoveMode
  PlayerController o-- MiningToolsController
  PlayerController ..> IInventory : inventory
  PlayerController ..> IItemManager : itemManager
  PlayerController +-- MoveMode
  PlayerInventory <|.. "Interfaces.IInventory"

  PlayerController o-- "1" PlayerVisualsController
  PlayerController o-- "1" MiningToolsController
  PlayerController ..> "Interfaces.IInventory" : uses
  PlayerController ..> "Interfaces.IItemManager" : uses
  PlayerController ..> "Interaction.MinecartPlayerInteractionSystem" : uses

  MiningToolsController --> PlayerController
  MiningToolsController o-- "2" "Mining.Digger" : creates
  MiningToolsController o-- "*" "Mining.Tools.MiningTool" : aggregates
  MiningToolsController ..> "Mining.Tools.MiningToolBehaviour" : creates

  PlayerVisualsController --> PlayerController
}

package "Interaction" {
  class MinecartPlayerInteractionSystem {
    - minecartDetectionRange: float
    - itemTransferSpeed: float
    - itemMoveSpeed: float
    - movementCurve: AnimationCurve
    - minecartManager: MinecartManager
    - playerController: PlayerController
    - isTransferringItems: bool
    - minecartOffset: float
    - Awake()
    - Update()
    + CheckMinecartProximity()
    + GetDetectionRange(): float
    + SetDetectionRange(range: float)
    + IsTransferringItems(): bool
    + GetDebugInfo(): string
  }

  class PassageController {
    - transitionSpeed: float
    - requiredInputThreshold: float
    - destinationSceneName: string
    - changeScene: ChangeScene
    - playerController: PlayerController
    - playerTransform: Transform
    - playerCollider: Collider
    - initialPlayerScale: Vector3
    - entryProgress: float
    - isPlayerInside: bool
    - OnTriggerEnter(other: Collider)
    - OnTriggerExit(other: Collider)
    - Update()
    - UpdateVisuals()
    - ResetState()
  }

  class SurfaceInteractionSystem {
    - surfaceDetectionRange: float
    - surfaceReturnPoint: Transform
    - itemTransferSpeed: float
    - itemMoveSpeed: float
    - movementCurve: AnimationCurve
    - playerController: PlayerController
    - storageManager: StorageManager
    - isTransferringItems: bool
    - Awake()
    - Update()
    - OnDestroy()
    + TransferAllInventoryToStorage()
  }

  MinecartPlayerInteractionSystem --> "Player.PlayerController"
  MinecartPlayerInteractionSystem --> "Minecart.MinecartManager"
  PassageController --> "Player.PlayerController"
  PassageController --> "SceneManagement.ChangeScene"
  SurfaceInteractionSystem --> "Player.PlayerController"
  SurfaceInteractionSystem --> "Storage.StorageManager"
}

package "Mining" {
  class Digger {
    + DiggingArea: BoxCollider
    - diggingArea: BoxCollider
    - pendingMiningModule: MiningModule
    - pendingMiningInfo: MiningInfo
    - isDiggingAreaOverridden: bool
    - Awake()
    + SetPendingMining(module: MiningModule, info: MiningInfo)
    + ExecuteDigFromAnimation(): UniTask<(HashSet<Block> hitBlocks, int destroyedVoxelCount)>
    + SetDiggingArea(area: BoxCollider)
    + UpdateDiggingAreaTransform(position: Vector3, rotation: Quaternion)
    + SetDiggingAreaParameters(center: Vector3, size: Vector3)
    - Update()
    + Dig(damagePerHit: int, info: MiningInfo): UniTask<(HashSet<Block> hitBlocks, int destroyedVoxelCount)>
    - GetHitBlocks(): HashSet<Block>
    - DigAsyncTask(damagePerHit: int, info: MiningInfo, hitBlocks: HashSet<Block>): UniTask<int>
  }

  enum MiningType {
    Directional
    ArcSwing
    Explosive
  }

  struct MiningInfo {
    + Type: MiningType
    + SourcePoint: Vector3
    + Direction: Vector3
    + Force: float
    + IsFacingRight: bool
    + {static} Directional(sourcePoint: Vector3, direction: Vector3, force: float): MiningInfo
    + {static} Explosive(sourcePoint: Vector3, force: float): MiningInfo
    + {static} ArcSwing(sourcePoint: Vector3, isFacingRight: bool, force: float): MiningInfo
  }

  class DroppedItem {
    + rb: Rigidbody
    + resourceType: ResourceType
    + scale: Vector3
    + blockDataName: string
    + uvBase: Vector2
    + uvSize: Vector2
    + useTexture1: bool
    - Awake()
    - OnEnable()
  }

  struct DroppedItemData {
    + position: Vector3
    + rotation: Quaternion
    + scale: Vector3
    + blockDataName: string
    + uvBase: Vector2
    + uvSize: Vector2
    + useTexture1: bool
    + isKinematic: bool
  }

  class "DroppedItemManager.ItemState" as ItemState {
    + isSleeping: bool
  }

  class DroppedItemManager <<Singleton>> {
    + WakeUpRadiusMultiplier: float
    + {static} Instance: DroppedItemManager
    + maxWakeUpsPerUpdate: int
    + MaxWakeUpPerStep: int
    + WakeUpStepDelay: float
    + MaxDownwardChain: int
    - _wakeUpRadiusMultiplier: float
    - itemPools: Map<GameObject, Queue<GameObject>>
    - instancePrefabMap: Map<GameObject, GameObject>
    - activeItems: List<DroppedItem>
    - itemStates: Map<DroppedItem, ItemState>
    - wakeUpRequestQueue: Queue<DroppedItem>
    - itemsInWakeUpQueue: HashSet<DroppedItem>
    - sleepCheckTimer: float
    - itemsByChunk: Map<Vector3Int, List<DroppedItemData>>
    - Awake()
    - Start()
    - OnDestroy()
    - Update()
    - ProcessWakeUpRequests()
    + WakeUpItemsInRadius(center: Vector3, size: Vector3, rotation: Quaternion)
    + ApplyForceToItemsInRadius(center: Vector3, size: Vector3, rotation: Quaternion, info: MiningInfo)
    + WakeUpItemsNearPosition(position: Vector3, radius: float)
    - ProcessWakeUpQueueAsync(initialItems: HashSet<DroppedItem>): UniTask
    + GetItem(prefab: GameObject): GameObject
    + GetActiveItems(): List<DroppedItem>
    + ReturnItem(itemInstance: GameObject)
    - SaveItems()
    - PrepareItemLoading()
    + LoadItemsInChunk(chunkPosition: Vector3Int)
    - SetDroppedItemConstraints(itemRigidbody: Rigidbody)
    - GetCurrentMoveMode(): PlayerController.MoveMode
  }

  DroppedItemManager +-- ItemState
  DroppedItemManager o-- "*" DroppedItem
  MiningInfo +-- MiningType

  package "Tools" {
    class MaterialSound {
      + materialType: MaterialType
      + sound: AudioClip
    }

    abstract class MiningTool <<ScriptableObject>> {
      # toolName: string
      # toolIcon: Sprite
      - toolTypeID: int
      - animationTriggerName: string
      - animationStateName: string
      - toolPrefab: GameObject
      + miningModule: MiningModule
      - volume: float
      - defaultMiningSound: AudioClip
      - materialSounds: List<MaterialSound>
      + ToolPrefab: GameObject
      + ToolTypeID: int
      + AnimationTriggerName: string
      + AnimationStateName: string
      + DefaultMiningSound: AudioClip
      + Volume: float
      + GetMiningSound(materialType: MaterialType): AudioClip
      + InstantiateBehaviour(parent: Transform): MiningToolBehaviour
      - OnValidate()
    }

    abstract class MiningModule <<ScriptableObject>> {
      # damagePerHit: int
      + {abstract} DiggingCenter: Vector3
      + {abstract} DiggingSize: Vector3
      + DamagePerHit: int
      + {abstract} Execute(user: GameObject)
    }

    abstract class MiningToolBehaviour {
      + ToolData: MiningTool
      # user: GameObject
      # toolAnimator: Animator
      # digger: Digger
      + IsMining: bool
      + IsEquipped: bool
      + BindTool(tool: MiningTool)
      + OnEquip(user: GameObject)
      + OnUnequip()
      + SetDigger(digger: Digger)
      + SetToolAnimator(animator: Animator)
      + {abstract} Use(direction: Vector3, playerController: PlayerController)
      + UpdateAim(direction: Vector3, moveMode: PlayerController.MoveMode)
      # PlayMiningSound()
    }

    class Dynamite extends MiningTool {
    }

    class DynamiteMiningModule extends MiningModule {
      - dynamitePrefab: GameObject
      - throwForce: float
      - maxThrowDistance: float
      - gravity: float
      - explosionForce: float
      - diggingCenter: Vector3
      - diggingSize: Vector3
      + ProjectilePrefab: GameObject
      + ThrowForce: float
      + MaxThrowDistance: float
      + Gravity: float
      + ExplosionForce: float
      + DiggingCenter: Vector3
      + DiggingSize: Vector3
      + Execute(user: GameObject)
    }

    class DynamiteProjectile {
      - explosionDelay: float
      - enableDebugLogs: bool
      - behaviour: DynamiteToolBehaviour
      - hasExploded: bool
      - Start()
      + SetBehaviour(b: DynamiteToolBehaviour)
      - Explode()
      - PerformMining()
      - PlayExplosionSound(hitBlocks: HashSet<Block>, destroyedVoxelCount: int)
      - OnDestroy()
      - OnDrawGizmos()
    }

    class DynamiteToolBehaviour extends MiningToolBehaviour {
      - owner: GameObject
      - playerController: PlayerController
      + OnEquip(user: GameObject)
      + Use(direction: Vector3, playerController: PlayerController)
      + UpdateAim(direction: Vector3, moveMode: PlayerController.MoveMode)
      - ComputeQuantizedDirection(user: GameObject, pc: PlayerController, isTopDown: bool): Vector3
      - ComputeBallisticDirection(user: GameObject, pc: PlayerController): Vector3
      - CalculateBallisticVelocity(horizontalDistance: float, verticalDistance: float, gravityValue: float): Vector3
      - Quantize8(v: Vector2): Vector2
      + PerformExplosionMining(explosionPosition: Vector3, center: Vector3, size: Vector3, damage: int, force: float): UniTask<(HashSet<Block> hitBlocks, int destroyedVoxelCount)>
    }

    class Pickaxe extends MiningTool {
    }

    class PickaxeMiningModule extends MiningModule {
      - centerOffset: Vector3
      - size: Vector3
      - miningForce: float
      - verticalCenterOffset: Vector3
      - verticalSize: Vector3
      - verticalMiningForce: float
      - mineTriggerName: string
      - isFacingRightBool: string
      - directionStateName: string
      + DiggingCenter: Vector3
      + DiggingSize: Vector3
      + MiningForce: float
      + VerticalDiggingCenter: Vector3
      + VerticalDiggingSize: Vector3
      + VerticalMiningForce: float
      + MineTriggerName: string
      + IsFacingRightBool: string
      + DirectionStateName: string
      + Execute(user: GameObject)
    }

    class PickaxeToolBehaviour extends MiningToolBehaviour {
      - toolMount: Transform
      - currentMoveMode: PlayerController.MoveMode
      - currentAimDirection: Vector3
      - useBuffered: bool
      - canBufferUse: bool
      - _playerController: PlayerController
      + OnEquip(user: GameObject)
      + Use(direction: Vector3, playerController: PlayerController)
      + UpdateAim(direction: Vector3, moveMode: PlayerController.MoveMode)
      + ExecuteDigFromAnimation()
      + OnMineAnimationEnd()
      + OpenBufferWindow()
      - UpdateToolRotation(direction: Vector3, moveMode: PlayerController.MoveMode)
      - OnDrawGizmos()
    }

    MiningTool o-- MiningModule
    MiningTool ..> MiningToolBehaviour : creates
    MiningToolBehaviour ..> MiningTool
    MiningToolBehaviour ..> Digger
    DynamiteToolBehaviour ..> DynamiteProjectile : creates
    DynamiteToolBehaviour ..> PlayerController
    DynamiteProjectile ..> DynamiteToolBehaviour
    PickaxeToolBehaviour ..> Digger
  }
}

package "Minecart" {
  enum MinecartState {
    Following
    GoingToGround
    Unloading
  }

  class Minecart {
    + gameObject: GameObject
    + movement: MinecartMovement
    + resources: Map<ResourceType, int>
    + time: float
    + state: MinecartState
    + capacityText: TextMeshProUGUI
    + CurrentLoad: int
    + Minecart(obj: GameObject)
    + ClearResources()
  }

  class MinecartManager {
    + playerTransform: Transform
    + minecartPrefab: GameObject
    + CartCapacity: int
    + minecartCapacityUIPrefab: GameObject
    + worldCanvasTransform: Transform
    + uiOffset: Vector3
    + groundStationPosition: Vector3
    + followMoveSpeed: float
    + groundMoveSpeed: float
    + unloadTime: float
    + cartunit: int
    + minecarts: List<Minecart>
    + pathRecordInterval: float
    + cartDistanceInPoints: int
    + maxPathPoints: int
    + digable: bool
    - pathPoints: List<Vector3>
    - Start()
    + addnewcart()
    + updatevalue(minecartnum: int, type: ResourceType, value: int)
    - SendCartToHome(minecartnum: int)
    + UpdateMinecartPositions()
    + UpdateMinecartPositions(playerPosition: Vector3, playerLastMoveDirection: Vector3, offset: float)
